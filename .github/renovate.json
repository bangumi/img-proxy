{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Trim21/renovate-config",
    "local>Trim21/renovate-config:monthly",
    "local>Trim21/renovate-config:go",
    "local>Trim21/renovate-config:app"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "enabled": false
    }
  ],
  "labels": [
    "ci:auto-merge",
    "dependencies"
  ],
  "prConcurrentLimit": 3
}
